{
  "name": "Python GPU Environment",
  "image": "nvidia/cuda:12.4.0-devel-ubuntu22.04",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "upgradePackages": true,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.config/opencode",
      "target": "/home/vscode/.config/opencode"
    }
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-vscode.cpptools-extension-pack",
        "ms-toolsai.jupyter-keymap",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true
      }
    }
  },

  "mounts": [
    "source=C:/Users/Johan/.cache/lm-studio/models,target=/models,type=bind,consistency=cached"
  ],

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential pybind11-dev libnifti-dev libnifti2-dev libznz-dev && pip install --upgrade pip && pip install -r requirements.txt",
  
  "remoteEnv": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,display"
  },

  "runArgs": [
    "--gpus=all"
  ],

  "forwardPorts": [],

  "remoteUser": "vscode",

  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "CUDA_VISIBLE_DEVICES": "0"
  }
}
// C:\Users\Johan\.cache\lm-studio\models
